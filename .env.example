APP_ENV=development
LOG_LEVEL=INFO
USER_AGENT=AisleyScraperBot/1.0 (+contact@example.com)

# Supabase is used only for object storage (product images), not table I/O.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_PATH=aisley

# Direct Postgres connection (psycopg). All store/product table reads & writes
# go through this. e.g. postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_CONNECT_TIMEOUT_SEC=10

PERSISTENCE_TARGET=supabase
LOCAL_OUTPUT_PATH=./out/scrape_results.json

# Folder of per-store TSV seed files (all *.tsv merged by url).
# Row format: url <tab> store_name <tab> addr1 <tab> addr2 ...
INPUT_TSV_DIR=./data/stores
INPUT_CSV_PATH=./data/stores.tsv
INPUT_CSV_HAS_HEADER=true
INPUT_CSV_URL_COLUMN=store_url
INPUT_CSV_SOURCE_ID_COLUMN=source_id
INPUT_CSV_NOTES_COLUMN=notes

CRAWL_MAX_STORES_PER_RUN=1000
CRAWL_GLOBAL_CONCURRENCY=15
CRAWL_STORE_BATCH_SIZE=3
CRAWL_PER_DOMAIN_CONCURRENCY=2
CRAWL_GLOBAL_QPS=8
CRAWL_REQUEST_TIMEOUT_SEC=25
CRAWL_CONNECT_TIMEOUT_SEC=10
# Verify TLS certs on crawl fetches. Default true (secure). Set to false ONLY to
# scrape stores with broken/expired certs — skips MITM protection for that run.
# Applies to the httpx clients, the curl fallback (-k), and curl_cffi.
CRAWL_SSL_VERIFY=true
CRAWL_MAX_RETRIES=4
CRAWL_BACKOFF_BASE_MS=500
CRAWL_BACKOFF_MAX_MS=8000
CRAWL_JITTER_MS=250
CRAWL_RESPECT_ROBOTS=true
CRAWL_ROBOTS_CACHE_TTL_SEC=3600
CRAWL_STALL_LOG_INTERVAL_SEC=60
STORE_PAGE_STREAMING_ENABLED=false
IMAGE_VALIDATION_CONCURRENCY=2
PHASE2_UPLOAD_CONCURRENCY=3
PHASE2_DB_UPSERT_BATCH_SIZE=500
POSTPROCESS_PRODUCT_CHUNK_SIZE=200
IMAGE_MIN_WIDTH=600
IMAGE_MIN_HEIGHT=800

# CLIP/SigLIP encoder for the fashion/non-fashion product classifier.
# Default is the fashion-specialized Marqo-FashionSigLIP (open_clip hf-hub).
# For a plain OpenCLIP checkpoint, set both (e.g. CLIP_MODEL_NAME=ViT-B-32 and
# CLIP_PRETRAINED=laion2b_s34b_b79k). NOTE: the product-photo threshold
# (PHASE2_FIRST_IMAGE_PRODUCT_PROB_THRESHOLD) is model-specific — re-tune it
# when changing the encoder.
CLIP_MODEL_NAME=hf-hub:Marqo/marqo-fashionSigLIP
CLIP_PRETRAINED=

# First-image product classifier samples the first K lead images per item and
# keeps it if ANY scores as a product photo (max over images).
PRODUCT_VALIDATION_MAX_IMAGES=3

# Phase 2 full-enrich: validate up to N lead images per product (kept if any
# passes). Set to 1 to validate only the first image (fastest). The FULL image
# gallery is always restored before writing to production — validation only
# decides keep/drop, it never trims a kept product's images.
PHASE2_MAX_IMAGES_PER_PRODUCT=5
# Lightweight mode: validate only the first image of existing products (see README).
PHASE2_FIRST_IMAGE_PRODUCT_VALIDATION_ONLY=false

# Optional Hugging Face auth token for higher download limits and fewer warnings.
HF_TOKEN=

ENABLE_BROWSER_FALLBACK=false
BROWSER_FALLBACK_CONCURRENCY=2
BROWSER_NAV_TIMEOUT_SEC=30

SHOPIFY_PRODUCTS_PAGE_LIMIT=250
SHOPIFY_PRODUCTS_MAX_PAGES=10000
SHOPIFY_PRODUCTS_MAX_ITEMS_PER_STORE=0
EXTRACT_ENABLE_JSONLD=true
EXTRACT_ENABLE_THEME_PAYLOAD=true
EXTRACT_ENABLE_DOM_FALLBACK=true
CLASSIFY_REQUIRE_ECOM_SIGNAL=true
DEDUPE_STRATEGY=shop_domain_product_variant

RUN_CHECKPOINT_INTERVAL_SEC=30
RUN_DEAD_LETTER_THRESHOLD=5

METRICS_ENABLED=true
METRICS_NAMESPACE=aisley_scraper

EXPORT_ENABLED=false
EXPORT_FORMAT=json
EXPORT_OUTPUT_PATH=./out/products.json
TZ=UTC
